# Environment and local configs
/public_html/app/config/config.local.php
.env
.env.*

# Logs and cache
/public_html/app/storage/logs/*.log
/public_html/app/storage/logs/*.log.php
!/public_html/app/storage/logs/.gitkeep
/public_html/app/storage/installed.lock
/public_html/app/storage/cache/htmlpurifier/*
!/public_html/app/storage/cache/htmlpurifier/.gitkeep
/public_html/app/storage/demo-manifest.json
/public_html/app/storage/self_test.json

# Uploads directory (preserve .htaccess and .gitkeep)
/public_html/uploads/*
!/public_html/uploads/.htaccess
!/public_html/uploads/.gitkeep
!/public_html/uploads/index.html

# Local standalone binaries
/tailwind/tailwindcss

# OS & Editor files
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace
.idea/
.vscode/
*.swp
*~

