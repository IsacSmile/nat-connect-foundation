# ==============================================================================
# NatConnect Foundation — Production .htaccess for Hostinger Shared Hosting
# ==============================================================================

# Note: "Options" and "Header" directives cause HTTP 500 on Hostinger and are strictly forbidden.
# Security headers are emitted from PHP in public_html/index.php.
# Directory indexing is prevented by empty index.html files.

# Set default charset
AddDefaultCharset UTF-8

# ------------------------------------------------------------------------------
# 1. Block Access to Hidden / Sensitive Files (.git, .env, .sql, etc.)
# ------------------------------------------------------------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|env))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. Static Asset Caching Directives (Fonts, CSS, JS, Images)
#    Note: mod_expires is unverified on Hostinger; harmless inside IfModule.
#    Static asset caching also relies on Hostinger CDN.
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Fonts (woff, woff2, ttf) - Cache 1 Year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # Images - Cache 1 Month
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript - Cache 1 Month (Cache-busted via asset() ?v= timestamp)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# ------------------------------------------------------------------------------
# 3. URL Rewriting — Route all non-file/dir requests to index.php
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure HTTPS in production on Hostinger (uncomment if not auto-forced by host)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 1. Strictly deny execution of any scripts inside /uploads/ (MUST run before front-controller)
    RewriteRule ^uploads/.*\.(php|php\d|phtml|phar|pl|py|cgi|sh)$ - [F,L,NC]

    # 2. Block direct access to internal application directories (Layer 1 Protection)
    RewriteRule ^(app|vendor|database)(/|$) - [F,L,NC]
    RewriteRule ^tailwind/ - [F,L]

    # 3. Front Controller: If requested path is NOT an existing file or directory, forward to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>
